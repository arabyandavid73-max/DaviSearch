<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="DaviSearch"
            android:textColor="#1769AA"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Локальная поисковая система"
            android:textColor="#718096"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Поиск по ФИО"
            android:textColor="#172B45"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/searchInput"
            android:hint="Введите ФИО"
            android:singleLine="true"
            android:padding="16dp"
            android:backgroundTint="#1769AA"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="58dp"/>

        <Button
            android:id="@+id/searchButton"
            android:text="Найти"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>

        <TextView
            android:text="Мои документы"
            android:textColor="#172B45"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/selectFolderButton"
            android:text="Выбрать папки"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>

        <TextView
            android:id="@+id/folderStatus"
            android:text="Папки ещё не выбраны"
            android:textColor="#718096"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Результаты поиска"
            android:textColor="#172B45"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/resultsText"
            android:text="Здесь появятся найденные совпадения"
            android:textColor="#718096"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
